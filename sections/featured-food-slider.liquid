<section class="featured-food page-width" data-featured-slider>
  <div class="section-head">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
    <div class="featured-food__track" role="list">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        <div class="featured-food__slide" role="listitem">
          {% render 'food-card', product: product %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p>Please choose a collection in this section to show featured foods.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured food slider",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Featured Dishes"},
    {"type": "collection", "id": "collection", "label": "Collection"},
    {"type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 1, "label": "Products to show", "default": 8}
  ],
  "presets": [{"name": "Featured food slider"}]
}
{% endschema %}
