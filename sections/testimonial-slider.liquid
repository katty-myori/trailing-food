{{ 'testimonial.css' | asset_url | stylesheet_tag }}
<script src="{{ 'testimonial.js' | asset_url }}" defer="defer"></script>

<section
  id="shopify-section-{{ section.id }}"
  class="testimonial-slider-section"
  style="
    --testimonial-bg: {{ section.settings.background_color }};
    --testimonial-text: {{ section.settings.text_color }};
    --testimonial-card-bg: {{ section.settings.card_background_color }};
    --testimonial-spacing-top: {{ section.settings.padding_top }}px;
    --testimonial-spacing-bottom: {{ section.settings.padding_bottom }}px;
  "
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  data-testimonial-section
>
  <div class="page-width testimonial-slider__inner">
    {% if section.settings.heading != blank %}
      <h2 class="testimonial-slider__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="testimonial-slider" data-testimonial-slider>
      <button class="testimonial-slider__nav testimonial-slider__nav--prev" type="button" aria-label="{{ 'general.accessibility.previous' | t | default: 'Previous testimonial' }}" data-slider-prev>
        &#10094;
      </button>

      <div class="testimonial-slider__viewport">
        <div class="testimonial-slider__track" data-slider-track>
          {% for block in section.blocks %}
            <article class="testimonial-slide" {{ block.shopify_attributes }}>
              <div class="testimonial-slide__image-wrap">
                {% if block.settings.customer_image != blank %}
                  {{ block.settings.customer_image | image_url: width: 240 | image_tag: loading: 'lazy', class: 'testimonial-slide__image', alt: block.settings.customer_name | escape }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'testimonial-slide__placeholder' }}
                {% endif %}
              </div>

              <div class="testimonial-slide__content">
                {% if block.settings.customer_name != blank %}
                  <h3 class="testimonial-slide__name">{{ block.settings.customer_name }}</h3>
                {% endif %}

                <div class="testimonial-slide__stars" aria-label="{{ block.settings.star_rating }} out of 5 stars">
                  {% for i in (1..5) %}
                    {% if i <= block.settings.star_rating %}
                      <span aria-hidden="true">★</span>
                    {% else %}
                      <span aria-hidden="true">☆</span>
                    {% endif %}
                  {% endfor %}
                </div>

                {% if block.settings.review_text != blank %}
                  <p class="testimonial-slide__review">{{ block.settings.review_text }}</p>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </div>

      <button class="testimonial-slider__nav testimonial-slider__nav--next" type="button" aria-label="{{ 'general.accessibility.next' | t | default: 'Next testimonial' }}" data-slider-next>
        &#10095;
      </button>
    </div>

    <div class="testimonial-slider__dots" data-slider-dots></div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonial slider",
  "tag": "section",
  "class": "section section-testimonial-slider",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 5
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fff7f0"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2d201c"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "customer_image",
          "label": "Customer image"
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name",
          "default": "Customer Name"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "Amazing food, fast delivery, and excellent quality. Highly recommended!"
        },
        {
          "type": "range",
          "id": "star_rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial slider",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Aarav Mehta",
            "review_text": "The biryani and kebabs were full of flavor. This is my go-to weekend order!",
            "star_rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Sophia Li",
            "review_text": "Loved the noodles and dim sum. Fresh ingredients and perfect spice levels.",
            "star_rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Marco Rossi",
            "review_text": "Best pasta in town! Rich sauces and generous portions every time.",
            "star_rating": 4
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Emily Carter",
            "review_text": "Fast delivery and crispy fries. The burgers were juicy and delicious.",
            "star_rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Noah Williams",
            "review_text": "Desserts were amazing, especially the lava cake. Great quality and packaging!",
            "star_rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
