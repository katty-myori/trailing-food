<section class="food-hero" style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="food-hero__media">
    {% if section.settings.background_image != blank %}
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: loading: 'eager', class: 'food-hero__image', alt: section.settings.heading }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'food-hero__image placeholder-svg' }}
    {% endif %}
  </div>
  <div class="food-hero__content page-width">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Food hero banner",
  "settings": [
    {"type": "image_picker", "id": "background_image", "label": "Background image"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Delicious Food, Fast Delivery"},
    {"type": "textarea", "id": "subheading", "label": "Subheading", "default": "Order freshly prepared meals from your favorite cuisines."},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Shop now"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 40}
  ],
  "presets": [{"name": "Food hero banner"}]
}
{% endschema %}
