<section class="food-product-grid page-width" data-food-grid>
  <div class="section-head">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  {% assign source_collection = section.settings.collection | default: collections.all %}
  {% if source_collection.products_count > 0 %}
    <div class="food-grid">
      {% for product in source_collection.products limit: section.settings.products_limit %}
        {% render 'food-card', product: product %}
      {% endfor %}
    </div>
  {% else %}
    <p>No products found. Add products to this collection to populate the food grid.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Food product grid",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Explore Our Menu"},
    {"type": "collection", "id": "collection", "label": "Collection"},
    {"type": "range", "id": "products_limit", "min": 4, "max": 24, "step": 1, "label": "Products to show", "default": 12}
  ],
  "presets": [{"name": "Food product grid"}]
}
{% endschema %}
